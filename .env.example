# Copiar a .env y completar. Nunca commitear .env real.

APP_ENV=local

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_data_analyst
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_data_analyst

# --- Conexion de solo lectura para el agente (RF-030) ---
# Rol Postgres separado, sin permisos sobre "public" (ver
# infrastructure/postgres/init/002-agent-readonly-role.sh). Nunca la
# credencial de la app (DATABASE_URL) se usa para SQL generado por el agente.
AGENT_READONLY_PASSWORD=changeme_agent_readonly
AGENT_DATABASE_URL=postgresql+asyncpg://agent_readonly:changeme_agent_readonly@postgres:5432/ai_data_analyst

# --- Redis / queue (ARQ) ---
REDIS_URL=redis://redis:6379/0

# --- Auth (credenciales + JWT, ver docs/adr/0002-auth-strategy.md) ---
AUTH_SECRET_KEY=changeme
AUTH_TOKEN_EXPIRE_MINUTES=60

# --- Secrets de conexiones a fuentes de datos (ver docs/adr/0004-secrets-management.md) ---
SECRET_ENCRYPTION_KEY=changeme

# --- LLM (proveedor abstraído, ver docs/architecture.md y docs/adr/0009-llm-provider.md) ---
# Kimi (Moonshot AI) via API compatible con OpenAI. Completar LLM_BASE_URL
# y LLM_MODEL con los valores exactos de tu cuenta (varian segun si es la
# plataforma china o la internacional) - no se hardcodean por las dudas.
LLM_PROVIDER=kimi
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- Límites del agente (RF-032 / RNF-003 en docs/SRS.md) ---
AGENT_SQL_TIMEOUT_SECONDS=30
AGENT_SQL_MAX_ROWS=5000
AGENT_SQL_MAX_JOINS=2
AGENT_SQL_MAX_SUBQUERIES=3

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
GRAFANA_ADMIN_PASSWORD=changeme

# --- pgAdmin (tooling de desarrollo local, no forma parte del SRS) ---
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=changeme_pgladmin

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
CORS_ORIGINS=http://localhost:5173
