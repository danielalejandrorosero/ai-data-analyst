# Copiar a .env y completar. Nunca commitear .env real.

APP_ENV=local

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_data_analyst
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_data_analyst

# --- Redis / queue (ARQ) ---
REDIS_URL=redis://redis:6379/0

# --- Auth (credenciales + JWT, ver docs/adr/0002-auth-strategy.md) ---
AUTH_SECRET_KEY=changeme
AUTH_TOKEN_EXPIRE_MINUTES=60

# --- Secrets de conexiones a fuentes de datos (ver docs/adr/0004-secrets-management.md) ---
SECRET_ENCRYPTION_KEY=changeme

# --- LLM (proveedor abstraído, ver docs/architecture.md) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- Límites del agente (RF-032 / RNF-003 en docs/SRS.md) ---
AGENT_SQL_TIMEOUT_SECONDS=30
AGENT_SQL_MAX_ROWS=5000

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
GRAFANA_ADMIN_PASSWORD=changeme

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:5173
